    "def minmax_score(series):\n",
    "    series = series.astype(float)\n",
    "    min_value = series.min()\n",
    "    max_value = series.max()\n",
    "    if pd.isna(min_value) or pd.isna(max_value) or max_value == min_value:\n",
    "        return pd.Series(1.0, index=series.index)\n",
    "    return (series - min_value) / (max_value - min_value)\n",
    "\n",
    "\n",
    "def score_existing_hub_candidates(df):\n",
    "    scored = df.copy()\n",
    "    scored['물량점수'] = minmax_score(np.log1p(scored['판매자인계주문수']))\n",
    "    scored['판매자수점수'] = minmax_score(np.log1p(scored['판매자수']))\n",
    "    scored['인계속도점수'] = 1 - minmax_score(scored['판매자_인계중앙일'])\n",
    "    scored['마감준수점수'] = 1 - minmax_score(scored['발송마감초과율'])\n",
    "    scored['기존허브_추정점수'] = (\n",
    "        0.35 * scored['물량점수']\n",
    "        + 0.35 * scored['인계속도점수']\n",
    "        + 0.20 * scored['판매자수점수']\n",
    "        + 0.10 * scored['마감준수점수']\n",
    "    )\n",
    "    return scored\n",
    "\n",
    "\n",
    "thresholds = [5, 10, 20, 30, 50]\n",
    "target_states = set(hub_candidates['state'].unique())\n",
    "target_state_count = len(target_states)\n",
    "total_handover_orders = seller_location_summary['판매자인계주문수'].sum()\n",
    "threshold_rows = []\n",
    "representative_by_threshold = {}\n",
    "previous_representative = None\n",
    "\n",
    "for threshold in thresholds:\n",
    "    eligible = seller_location_summary[\n",
    "        seller_location_summary['판매자인계주문수'].ge(threshold)\n",
    "    ].copy()\n",
    "    scored = score_existing_hub_candidates(eligible)\n",
    "    representative = (\n",
    "        scored\n",
    "        .sort_values(['seller_state', '기존허브_추정점수'], ascending=[True, False])\n",
    "        .groupby('seller_state', as_index=False)\n",
    "        .first()\n",
    "    )\n",
    "    representative_by_threshold[threshold] = representative\n",
    "\n",
    "    if previous_representative is None:\n",
    "        stability = np.nan\n",
    "    else:\n",
    "        compare = representative[['seller_state', 'seller_zip_code_prefix']].merge(\n",
    "            previous_representative[['seller_state', 'seller_zip_code_prefix']],\n",
    "            on='seller_state',\n",
    "            how='inner',\n",
    "            suffixes=('', '_이전기준'),\n",
    "        )\n",
    "        stability = (\n",
    "            compare['seller_zip_code_prefix'].eq(compare['seller_zip_code_prefix_이전기준']).mean()\n",
    "            if len(compare)\n",
    "            else np.nan\n",
    "        )\n",
    "\n",
    "    threshold_rows.append({\n",
    "        '최소주문수기준': threshold,\n",
    "        '후보위치수': len(eligible),\n",
    "        '커버주수': eligible['seller_state'].nunique(),\n",
    "        '대상주커버수': len(set(representative['seller_state']) & target_states),\n",
    "        '커버주문수': eligible['판매자인계주문수'].sum(),\n",
    "        '커버주문비율': eligible['판매자인계주문수'].sum() / total_handover_orders,\n",
    "        '대표후보안정성': stability,\n",
    "        '중앙_표준오차': eligible['판매자_인계표준오차'].median(),\n",
    "    })\n",
    "    previous_representative = representative\n",
    "\n",
    "seller_handover_threshold_sensitivity = pd.DataFrame(threshold_rows)\n",
    "seller_handover_threshold_sensitivity['균형점수'] = (\n",
    "    0.45 * seller_handover_threshold_sensitivity['커버주문비율']\n",
    "    + 0.25 * (seller_handover_threshold_sensitivity['대상주커버수'] / target_state_count)\n",
    "    + 0.20 * seller_handover_threshold_sensitivity['대표후보안정성'].fillna(0)\n",
    "    + 0.10 * (1 - minmax_score(seller_handover_threshold_sensitivity['중앙_표준오차']).fillna(0))\n",
    ")\n",
    "\n",
    "balanced_threshold = int(\n",
    "    (\n",
    "        seller_handover_threshold_sensitivity\n",
    "        .query('커버주문비율 >= 0.75 and 대상주커버수 == @target_state_count')\n",
    "        if not seller_handover_threshold_sensitivity\n",
    "        .query('커버주문비율 >= 0.75 and 대상주커버수 == @target_state_count')\n",
    "        .empty\n",
    "        else seller_handover_threshold_sensitivity[\n",
    "            seller_handover_threshold_sensitivity['커버주문비율'].ge(0.75)\n",
    "            & seller_handover_threshold_sensitivity['대상주커버수'].eq(\n",
    "                seller_handover_threshold_sensitivity['대상주커버수'].max()\n",
    "            )\n",
    "        ]\n",
    "    )\n",
    "    .sort_values('균형점수', ascending=False)\n",
    "    .head(1)['최소주문수기준']\n",
    "    .iloc[0]\n",
    ")\n",
    "\n",
    "display(seller_handover_threshold_sensitivity)\n",
    "print(f'선택된 최소 주문 수 기준: {balanced_threshold}건')"
   ]
  },
