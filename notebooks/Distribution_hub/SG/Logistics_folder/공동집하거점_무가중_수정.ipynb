   "source": [
    "from math import radians, sin, cos, asin, sqrt\n",
    "\n",
    "orders_for_handover = pd.read_csv(\n",
    "    DATA_DIR / 'olist_orders_dataset.csv',\n",
    "    usecols=[\n",
    "        'order_id',\n",
    "        'order_status',\n",
    "        'order_approved_at',\n",
    "        'order_delivered_carrier_date',\n",
    "    ],\n",
    ")\n",
    "items_for_handover = pd.read_csv(\n",
    "    DATA_DIR / 'olist_order_items_dataset.csv',\n",
    "    usecols=['order_id', 'seller_id', 'shipping_limit_date'],\n",
    ")\n",
    "sellers_for_handover = pd.read_csv(\n",
    "    DATA_DIR / 'olist_sellers_dataset.csv',\n",
    "    usecols=['seller_id', 'seller_zip_code_prefix', 'seller_city', 'seller_state'],\n",
    ")\n",
    "geo_for_handover = pd.read_csv(\n",
    "    DATA_DIR / 'olist_geolocation_dataset.csv',\n",
    "    usecols=[\n",
    "        'geolocation_zip_code_prefix',\n",
    "        'geolocation_lat',\n",
    "        'geolocation_lng',\n",
    "        'geolocation_state',\n",
    "    ],\n",
    ")\n",
    "\n",
    "for col in ['order_approved_at', 'order_delivered_carrier_date']:\n",
    "    orders_for_handover[col] = pd.to_datetime(orders_for_handover[col], errors='coerce')\n",
    "items_for_handover['shipping_limit_date'] = pd.to_datetime(\n",
    "    items_for_handover['shipping_limit_date'],\n",
    "    errors='coerce',\n",
    ")\n",
    "\n",
    "seller_shipments = (\n",
    "    items_for_handover\n",
    "    .drop_duplicates(['order_id', 'seller_id'])\n",
    "    .merge(orders_for_handover, on='order_id', how='left')\n",
    "    .merge(sellers_for_handover, on='seller_id', how='left')\n",
    ")\n",
    "seller_shipments = seller_shipments[\n",
    "    seller_shipments['order_status'].eq('delivered')\n",
    "    & seller_shipments['order_approved_at'].notna()\n",
    "    & seller_shipments['order_delivered_carrier_date'].notna()\n",
    "    & seller_shipments['seller_state'].notna()\n",
    "].copy()\n",
    "\n",
    "seller_shipments['판매자_인계소요일'] = (\n",
    "    seller_shipments['order_delivered_carrier_date']\n",
    "    - seller_shipments['order_approved_at']\n",
    ").dt.total_seconds() / 86400\n",
    "seller_shipments['발송마감대비_인계지연일'] = (\n",
    "    seller_shipments['order_delivered_carrier_date']\n",
    "    - seller_shipments['shipping_limit_date']\n",
    ").dt.total_seconds() / 86400\n",
    "seller_shipments['발송마감초과여부'] = seller_shipments['발송마감대비_인계지연일'].gt(0).astype(int)\n",
    "\n",
    "# 극단적인 기록 오류를 줄이기 위해 0~30일 범위의 인계소요일만 사용한다.\n",
    "seller_shipments = seller_shipments[\n",
    "    seller_shipments['판매자_인계소요일'].between(0, 30)\n",
    "].copy()\n",
    "\n",
    "geo_zip = (\n",
    "    geo_for_handover\n",
    "    .groupby(['geolocation_zip_code_prefix', 'geolocation_state'], as_index=False)\n",
    "    .agg(\n",
    "        위도=('geolocation_lat', 'median'),\n",
    "        경도=('geolocation_lng', 'median'),\n",
    "    )\n",
    "    .rename(columns={\n",
    "        'geolocation_zip_code_prefix': 'seller_zip_code_prefix',\n",
    "        'geolocation_state': 'seller_state',\n",
    "    })\n",
    ")\n",
    "\n",
    "seller_location_summary = (\n",
    "    seller_shipments\n",
    "    .groupby(['seller_state', 'seller_city', 'seller_zip_code_prefix'], as_index=False)\n",
    "    .agg(\n",
    "        판매자인계주문수=('order_id', 'nunique'),\n",
    "        판매자수=('seller_id', 'nunique'),\n",
    "        판매자_인계평균일=('판매자_인계소요일', 'mean'),\n",
    "        판매자_인계중앙일=('판매자_인계소요일', 'median'),\n",
    "        판매자_인계표준편차=('판매자_인계소요일', 'std'),\n",
    "        발송마감초과율=('발송마감초과여부', 'mean'),\n",
    "    )\n",
    "    .merge(geo_zip, on=['seller_zip_code_prefix', 'seller_state'], how='left')\n",
    "    .dropna(subset=['위도', '경도'])\n",
    ")\n",
    "seller_location_summary['판매자_인계표준오차'] = (\n",
    "    seller_location_summary['판매자_인계표준편차']\n",
    "    / np.sqrt(seller_location_summary['판매자인계주문수'])\n",
    ")\n",
    "\n",
    "display(seller_location_summary.sort_values('판매자인계주문수', ascending=False).head(10))\n",
    "print('판매자-주문 표본 수:', len(seller_shipments))\n",
    "print('판매자 위치 후보 수:', len(seller_location_summary))"
   ]
  },
