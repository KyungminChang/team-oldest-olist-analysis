    "base_weight_series = pd.Series(\n",
    "    base_weights,\n",
    "    name=\"Base\"\n",
    ")[score_cols]\n",
    "\n",
    "weight_compare = pd.concat(\n",
    "    [\n",
    "        base_weight_series,\n",
    "        ahp_weight_series,\n",
    "        entropy_weight_series,\n",
    "        critic_weight_series,\n",
    "        pca_weight_series\n",
    "    ],\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "weight_compare.index = [\n",
    "    score_name_map[col]\n",
    "    for col in weight_compare.index\n",
    "]\n",
    "\n",
    "display(weight_compare.round(4))"
   ]
