    "def haversine_km(lat1, lon1, lat2, lon2):\n",
    "    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])\n",
    "    dlat = lat2 - lat1\n",
    "    dlon = lon2 - lon1\n",
    "    a = sin(dlat / 2) ** 2 + cos(lat1) * cos(lat2) * sin(dlon / 2) ** 2\n",
    "    return 6371.0088 * 2 * asin(sqrt(a))\n",
    "\n",
    "\n",
    "hub_vs_existing_hub_comparison = (\n",
    "    hub_candidates\n",
    "    .merge(\n",
    "        seller_handover_existing_hub_estimates,\n",
    "        left_on='state',\n",
    "        right_on='주',\n",
    "        how='left',\n",
    "    )\n",
    ")\n",
    "hub_vs_existing_hub_comparison['기존추정허브와거리_km'] = hub_vs_existing_hub_comparison.apply(\n",
    "    lambda row: haversine_km(\n",
    "        row['hub_lat'],\n",
    "        row['hub_lng'],\n",
    "        row['기존허브추정_위도'],\n",
    "        row['기존허브추정_경도'],\n",
    "    )\n",
    "    if pd.notna(row['기존허브추정_위도']) and pd.notna(row['hub_lat'])\n",
    "    else np.nan,\n",
    "    axis=1,\n",
    ")\n",
    "hub_vs_existing_hub_comparison['기존허브보완필요도'] = pd.cut(\n",
    "    hub_vs_existing_hub_comparison['기존추정허브와거리_km'],\n",
    "    bins=[-np.inf, 50, 150, np.inf],\n",
    "    labels=['기존망 확장 우선', '중간 검토', '신규 거점 필요성 높음'],\n",
    ")\n",
    "\n",
    "comparison_cols = [\n",
    "    'state',\n",
    "    'suggested_city',\n",
    "    'hub_score',\n",
    "    'rank_mean',\n",
    "    '기존허브추정_도시',\n",
    "    '판매자_인계중앙일',\n",
    "    '판매자인계주문수',\n",
